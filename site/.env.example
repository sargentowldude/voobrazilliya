# Copy this file to .env and replace placeholders before deployment.
PORT=3000
SITE_URL=https://аниматоры-кемерово.рф

# Set to 1 only when the app is behind exactly one trusted reverse proxy.
TRUST_PROXY=0

# ID счётчика Яндекс Метрики (только цифры). Если не задан, Метрика не загружается.
YANDEX_METRIKA_ID=

ADMIN_USERNAME=replace-with-a-unique-username
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_COOKIE_SECRET=replace-with-a-long-random-secret

# Contacts published in the privacy policy. Fill in before publishing the site.
PERSONAL_DATA_EMAIL=personal-data@example.ru
PERSONAL_DATA_POSTAL_ADDRESS=Russia, city, postal address

# Email delivery for new leads. For Mail.ru use smtp.mail.ru, port 465 and an app password.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-mailbox@mail.ru
SMTP_PASSWORD=replace-with-a-mail-app-password
SMTP_FROM=your-mailbox@mail.ru
SMTP_TO=leads-recipient@mail.ru
