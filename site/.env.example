# Copy this file to .env and replace placeholders before deployment.
PORT=3000
SITE_URL=http://localhost:3000

ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_COOKIE_SECRET=replace-with-a-long-random-secret

# Contacts published in the privacy policy. Fill in before publishing the site.
PERSONAL_DATA_EMAIL=personal-data@example.ru
PERSONAL_DATA_POSTAL_ADDRESS=Russia, city, postal address

# Optional HTTPS relay that forwards new leads to Telegram.
TELEGRAM_LEADS_PROXY_URL=https://your-relay.example.com/telegram/leads
TELEGRAM_LEADS_PROXY_SECRET=shared-secret-for-your-relay
